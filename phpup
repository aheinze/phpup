  log ""

  # Check prerequisites
  if ! command_exists docker; then
    err "Docker is required to build custom FrankenPHP binaries"
    log "Please install Docker first: https://docs.docker.com/get-docker/"
    exit 1
  fi

  # Check docker buildx
  if ! docker buildx version >/dev/null 2>&1; then
