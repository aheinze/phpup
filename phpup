}

command_exists() { command -v "$1" >/dev/null 2>&1; }

# Check if we're running interactively
is_interactive() {
  [ -t 0 ] && [ -t 1 ]
}

# Wrapper for commands needing elevation
elevate_cmd() {
  local cmd="$*"
  
  # If we have an interactive terminal, just use sudo 
  if is_interactive; then
    sudo sh -c "$cmd"
    return $?
  fi
  
  # For non-interactive (e.g. Tauri Desktop App running in bg), try GUI elevation
  if command_exists pkexec; then
    pkexec sh -c "$cmd"
  elif command_exists osascript; then
    # macOS fallback
    osascript -e "do shell script \"$cmd\" with administrator privileges"
  else
    # Fallback to sudo, though it will likely fail without a tty
    sudo sh -c "$cmd"
  fi
}

# Cross-platform stat helpers (Linux uses -c, macOS uses -f)
get_file_perms() {
  local file="$1"
  if stat -c %a "$file" 2>/dev/null; then
    return
  fi
  stat -f %Lp "$file" 2>/dev/null || echo "unknown"
}

get_file_owner_uid() {
  local file="$1"
  if stat -c %u "$file" 2>/dev/null; then
    return
  fi
  stat -f %u "$file" 2>/dev/null || echo "0"
}

# Production hardening checks
security_checks() {
  local warnings=0

  # Check if running as root (security risk)
  if [ "$(id -u)" = "0" ]; then
    err "Security Warning: Running as root is not recommended for development servers"
    warnings=$((warnings + 1))
  fi

  # Check for sensitive files in docroot
  if [ -n "$DOCROOT" ] && [ -d "$DOCROOT" ]; then
    for sensitive_file in ".env" ".git" "config.php" "wp-config.php" ".htaccess" ".htpasswd"; do
      if [ -f "$DOCROOT/$sensitive_file" ]; then
        log "⚠️  Security Warning: Sensitive file found in docroot: $sensitive_file"
        warnings=$((warnings + 1))
      fi
    done
  fi

  # Check for weak file permissions
  if [ -f ".phpup/.env" ]; then
    env_perms=$(get_file_perms ".phpup/.env")
    if [ "$env_perms" != "600" ] && [ "$env_perms" != "unknown" ]; then
      log "⚠️  Security Warning: .env file has permissive permissions ($env_perms), should be 600"
      warnings=$((warnings + 1))
    fi
  fi

  return $warnings
}

# Set secure file permissions
secure_files() {
  # Secure .env file if it exists
  if [ -f ".phpup/.env" ]; then
    chmod 600 ".phpup/.env" 2>/dev/null || true
  fi

  # Secure configuration directory
  if [ -d ".phpup" ]; then
    chmod 700 ".phpup" 2>/dev/null || true
  fi

  # Secure config file
  if [ -f "$CONFIG_FILE" ]; then
    chmod 600 "$CONFIG_FILE" 2>/dev/null || true
  fi
}

# Load configuration from .phpup/config
load_config() {
  if [ ! -f "$CONFIG_FILE" ]; then
    return 0
  fi

  debug "Loading configuration from $CONFIG_FILE"

  while IFS='=' read -r key value || [ -n "$key" ]; do
    # Skip empty lines and comments
    case "$key" in
      ''|'#'*) continue ;;
    esac

    # Parse literal values; never source project configuration or use shell expansion.
    key="${key#"${key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    if [ "${#value}" -ge 2 ] && [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
      value="${value:1:${#value}-2}"
    fi

    # CLI arguments are parsed later; the last saved value wins.
    case "$key" in
      HOST) HOST="$value" ;;
      PORT) [ -n "${PORT:-}" ] || START_PORT="$value" ;;
      DOMAIN) DOMAIN="$value" ;;
      HTTPS_MODE) HTTPS_MODE="$value" ;;
      WORKER_MODE) WORKER_MODE="$value" ;;
      WATCH_MODE) WATCH_MODE="$value" ;;
      COMPRESSION) COMPRESSION="$value" ;;
      MAX_WAIT_TIME) MAX_WAIT_TIME="$value" ;;
      PHP_THREADS) PHP_THREADS="$value" ;;
      DOCROOT) DOCROOT="$value" ;;
      OPEN_BROWSER) OPEN_BROWSER="$value" ;;
      XDEBUG) XDEBUG="$value" ;;
    esac
    :
  done < "$CONFIG_FILE"
}

# Save configuration to .phpup/config
save_config() {
  mkdir -p .phpup
  local tmp
  tmp=$(mktemp .phpup/config.XXXXXX) || return 1
  {
    printf '# phpup configuration\n# Command-line flags override these settings.\n'
    printf '%s\n' "HOST=$HOST" "PORT=$START_PORT" "DOMAIN=$DOMAIN" \
      "HTTPS_MODE=$HTTPS_MODE" "WORKER_MODE=$WORKER_MODE" "WATCH_MODE=$WATCH_MODE" \
      "COMPRESSION=$COMPRESSION" "PHP_THREADS=$PHP_THREADS" "MAX_WAIT_TIME=$MAX_WAIT_TIME" \
      "DOCROOT=$DOCROOT" "OPEN_BROWSER=$OPEN_BROWSER" "XDEBUG=$XDEBUG"
  } > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
  log "Configuration saved: $CONFIG_FILE"
}

# Auto-detect domain from folder name
infer_domain() {
  local folder_name
  folder_name=$(basename "$(pwd)" | tr '[:upper:]' '[:lower:]' | tr '_' '-')
  echo "${folder_name}.test"
}

# Sanitize and validate domain name
sanitize_domain() {
  local domain="$1"
  # Lowercase first, then remove any dangerous characters - only allow alphanumeric, dash, and dot
  echo "$domain" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9.-'
}

# Validate domain name
validate_domain() {
  local domain="$1"

  # Block any potentially dangerous characters (extra safety check)
  if [[ "$domain" =~ [\*\;\$\`\{\}\|\<\>\"\'] ]]; then
    return 1
  fi

  # Allow .test, .local, .localhost TLDs and standard domain format
  if [[ "$domain" =~ ^[a-z0-9][a-z0-9\.-]*[a-z0-9]\.(test|local|localhost)$ ]] || \
     [[ "$domain" =~ ^[a-z0-9][a-z0-9\.-]*\.[a-z]{2,}$ ]]; then
    return 0
  fi
  return 1
}

# Check if mkcert is available and set up
check_mkcert() {
  if command_exists mkcert; then
    # Check if CA is installed
    if [ -f "$(mkcert -CAROOT 2>/dev/null)/rootCA.pem" ]; then
      return 0
    fi
  fi
  return 1
}

# Setup mkcert for local SSL
setup_mkcert() {
  log "🔐 Setting up local SSL with mkcert..."

  if ! command_exists mkcert; then
    log "📥 mkcert not found. Installing..."

    # Platform-specific installation
    if command_exists brew; then
      brew install mkcert nss
    elif command_exists apt-get; then
      log "   Please install mkcert manually:"
      log "   https://github.com/FiloSottile/mkcert#installation"
      return 1
    else
      log "⚠️  Could not auto-install mkcert"
      log "   Please install manually: https://github.com/FiloSottile/mkcert"
      return 1
    fi
  fi

  # Install local CA if not already installed
  if [ ! -f "$(mkcert -CAROOT 2>/dev/null)/rootCA.pem" ]; then
    log "🔧 Installing local Certificate Authority..."
    if ! is_interactive; then
      log "   Elevating privileges for mkcert CA installation..."
      elevate_cmd "mkcert -install" || return 1
    else
      mkcert -install || return 1
    fi
  fi

  return 0
}

# Generate SSL certificate for domain
generate_cert() {
  local domain="$1"

  if [ -z "$domain" ]; then
    return 1
  fi

  mkdir -p .phpup/certs

  if [ -f ".phpup/certs/${domain}.pem" ] && [ -f ".phpup/certs/${domain}-key.pem" ]; then
    debug "SSL certificate for $domain already exists"
    return 0
  fi

  log "📜 Generating SSL certificate for $domain..."

  # Use subshell to avoid changing working directory of the main script
  (
    cd .phpup/certs || exit 1
    mkcert "$domain" "*.${domain}" >/dev/null 2>&1 || exit 1

    # mkcert creates files with specific names, rename them for consistency
    if [ -f "${domain}+1.pem" ]; then
      mv "${domain}+1.pem" "${domain}.pem"
      mv "${domain}+1-key.pem" "${domain}-key.pem"
    fi
  )

  if [ -f ".phpup/certs/${domain}.pem" ]; then
    log "✅ SSL certificate generated for $domain"
    return 0
  fi

  return 1
}

# Manage /etc/hosts entry for domain
manage_hosts_entry() {
  local action="$1"  # add or remove
  local domain="$2"
  local ip="${3:-127.0.0.1}"

  # Optional path is used by the isolated hosts lifecycle tests.
  local hosts_file="${4:-/etc/hosts}"
  local marker="# phpup-managed"

  # Check if we need sudo
  if [ ! -w "$hosts_file" ]; then
    if ! command_exists sudo && ! command_exists pkexec && ! command_exists osascript; then
      log "⚠️  Cannot modify $hosts_file (no elevation tool available)"
      return 1
    fi
  fi

  if [ "$action" = "add" ]; then
    # Check if entry already exists (use -F for literal string matching)
    if awk -v ip="$ip" -v domain="$domain" '$1 == ip {for (i=2;i<=NF && $i !~ /^#/;i++) if ($i == domain) found=1} END {exit !found}' "$hosts_file"; then
      debug "Domain $domain already in $hosts_file"
      return 0
    fi

    log "🌍 Adding $domain to $hosts_file"
    log "   This requires sudo permission..."

    # Add entry with marker
    if [ -w "$hosts_file" ]; then
      echo "$ip $domain $marker" >> "$hosts_file" || return 1
    else
      elevate_cmd "echo '$ip $domain $marker' >> '$hosts_file'" >/dev/null || return 1
    fi

    HOSTS_ENTRY_ADDED=1
    log "✅ Added $domain → $ip to hosts file"

  elif [ "$action" = "remove" ]; then
    if grep -Fq "$domain $marker" "$hosts_file" 2>/dev/null; then
      log "🗑️  Removing $domain from $hosts_file"

      # Escape dots in domain for safe use in sed regex
      local escaped_domain="${domain//./\\.}"
      if [ -w "$hosts_file" ]; then
        sed -i.backup "/^127\\.0\\.0\\.1 ${escaped_domain} ${marker}$/d" "$hosts_file"
      else
        elevate_cmd "sed -i.backup '/^127\\.0\\.0\\.1 ${escaped_domain} ${marker}$/d' '$hosts_file'"
      fi

      log "✅ Removed $domain from hosts file"
    fi
  fi

  return 0
}

is_port_free() {
  # Returns 0 if free, 1 if taken
  local host="$1" port="$2"
  if command_exists ss; then
    # ss: list listening TCP sockets on given port
    if ss -Hln "sport = :$port" 2>/dev/null | grep -q .; then
      return 1
    else
      return 0
    fi
  elif command_exists lsof; then
    if lsof -iTCP -sTCP:LISTEN -P -n 2>/dev/null | awk '{print $9}' | grep -Eq ":$port( |$)"; then
      return 1
    else
      return 0
    fi
  elif command_exists nc; then
    if nc -z "$host" "$port" >/dev/null 2>&1; then
      return 1
    else
      return 0
    fi
  else
    # Fallback: bash TCP check
    if (echo >/dev/tcp/"$host"/"$port") >/dev/null 2>&1; then
      return 1
    else
      return 0
    fi
  fi
}

find_free_port() {
  local host="$1" start="$2" max_increments=2000
  local p="$start"
  for _ in $(seq 0 "$max_increments"); do
    [ "$p" -le 65535 ] || break
    if is_port_free "$host" "$p"; then
      echo "$p"
      return 0
    fi
    p=$((p+1))
  done
  return 1
}

# Input validation functions
validate_host() {
  local host="$1"
  # Allow localhost, IPv4, IPv6, and valid hostnames
  if [[ "$host" =~ ^(localhost|127\.0\.0\.1|::1|0\.0\.0\.0)$ ]] || \
     [[ "$host" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || \
     [[ "$host" =~ ^[a-zA-Z0-9][a-zA-Z0-9\.-]*[a-zA-Z0-9]$ ]]; then
    return 0
  fi
  return 1
}

validate_port() {
  local port="$1"
  # Must be numeric and in valid range
  if [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; then
    return 0
  fi
  return 1
}

validate_file_path() {
  local path="$1" must_exist="$2"
  # Keep Caddy placeholders and line-oriented configuration unambiguous.
  # Ordinary spaces, Unicode and apostrophes are valid filesystem names.
  [[ -n "$path" && ! "$path" =~ [[:cntrl:]] && "$path" != *'{'* && "$path" != *'}'* ]] || return 1
  case "/$path/" in */../*) return 1 ;; esac
  case "$path" in /etc/*|/usr/*|/bin/*|/sbin/*|/var/*|/sys/*|/proc/*) return 1 ;; esac
  [ "$must_exist" != "true" ] || [ -f "$path" ]
}

validate_threads() {
  local threads="$1"
  if [ "$threads" = "auto" ]; then
    return 0
  fi
  if [[ "$threads" =~ ^[0-9]+$ ]] && [ "$threads" -ge 1 ] && [ "$threads" -le 256 ]; then
    return 0
  fi
  return 1
}

validate_time() {
  local time="$1"
  # Accept formats like: 30s, 5m, 1h, 120
  if [[ "$time" =~ ^[0-9]+[smh]?$ ]]; then
    return 0
  fi
  return 1
}

# Load configuration before parsing arguments (CLI args will override config)
load_config || CONFIG_READ_ERROR=1

# Parse args with validation
while [ $# -gt 0 ]; do
  case "$1" in
    --host)
      if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
        err "--host requires a value"; exit 2
      fi
      if ! validate_host "$2"; then
        err "Invalid host: $2 (must be localhost, valid IP, or hostname)"; exit 2
      fi
      HOST="$2"; shift 2;;
    --port|--start-port)
      if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
        err "--port requires a value"; exit 2
      fi
      if ! validate_port "$2"; then
        err "Invalid port: $2 (must be 1-65535)"; exit 2
      fi
      START_PORT="$2"; shift 2;;
    --caddyfile)
      if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
        err "--caddyfile requires a value"; exit 2
      fi
      if ! validate_file_path "$2" "false"; then
        err "Invalid Caddyfile path: $2 (path traversal not allowed)"; exit 2
      fi
      CADDYFILE="$2"; shift 2;;
    --docroot)
      if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
        err "--docroot requires a value"; exit 2
      fi
      if ! validate_file_path "$2" "false"; then
        err "Invalid docroot path: $2 (path traversal not allowed)"; exit 2
      fi
      DOCROOT="$2"; shift 2;;
    --php-threads)
      if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
        err "--php-threads requires a value"; exit 2
      fi
      if ! validate_threads "$2"; then
        err "Invalid PHP threads: $2 (must be 'auto' or 1-256)"; exit 2
      fi
      PHP_THREADS="$2"; shift 2;;
    --max-wait)
      if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
        err "--max-wait requires a value"; exit 2
      fi
      if ! validate_time "$2"; then
        err "Invalid max wait time: $2 (use format like 30s, 5m, 1h)"; exit 2
      fi
      MAX_WAIT_TIME="$2"; shift 2;;
    --worker)
      WORKER_MODE=1; shift;;
    --no-domain)
      DOMAIN=""; shift;;
    --no-worker)
      WORKER_MODE=0; shift;;
    --no-watch)
      WATCH_MODE=0; shift;;
    --no-xdebug)
      XDEBUG=0; shift;;
    --watch)
      WATCH_MODE=1; shift;;
    --watch-pattern)
      if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
        err "--watch-pattern requires a value"; exit 2
      fi
      # Basic validation for watch patterns
      if [[ "$2" =~ ^[a-zA-Z0-9*./,_-]+$ ]]; then
        WATCH_PATTERNS="${WATCH_PATTERNS}${WATCH_PATTERNS:+,}$2"
      else
        err "Invalid watch pattern: $2"; exit 2
      fi
      shift 2;;
    --https)
      if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
        err "--https requires a value"; exit 2
      fi
      if [ "$2" != "off" ] && [ "$2" != "local" ] && [ "$2" != "on" ]; then
        err "Invalid HTTPS mode: $2 (must be: off, local, or on)"; exit 2
      fi
      HTTPS_MODE="$2"; shift 2;;
    --compression)
      COMPRESSION=1; shift;;
    --no-compression)
      COMPRESSION=0; shift;;
    --open|-o)
      OPEN_BROWSER=1; shift;;
    --no-open)
      OPEN_BROWSER=0; shift;;
    --xdebug)
      XDEBUG=1; shift;;
    --verbose|-v)
      VERBOSE=1; shift;;
    --env-file)
      if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
        err "--env-file requires a value"; exit 2
      fi
      if ! validate_file_path "$2" "false"; then
        err "Invalid env file path: $2 (path traversal not allowed)"; exit 2
      fi
      ENV_FILE="$2"; shift 2;;
    --domain)
      if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
        err "--domain requires a value"; exit 2
      fi
      # Convert to lowercase for consistency
      domain_input=$(echo "$2" | tr '[:upper:]' '[:lower:]')
      if ! validate_domain "$domain_input"; then
        err "Invalid domain: $2 (use format like myapp.test, myapp.local)"; exit 2
      fi
      DOMAIN="$domain_input"; shift 2;;
    --auto-domain)
      AUTO_DOMAIN=1; shift;;
    --no-hosts)
      MANAGE_HOSTS=0; shift;;
    --save)
      SAVE_MODE=1; shift;;
    --init)
      INIT_MODE=1; shift;;
    --force)
      FORCE_MODE=1; shift;;
    --install)
      INSTALL_MODE=1; shift;;
    --build-php)
      BUILD_PHP_MODE=1; shift;;
    --stop)
      STOP_MODE=1; shift;;
    --all)
      STOP_ALL=1; shift;;
    doctor|--doctor)
      DOCTOR_MODE=1; shift;;
    --json)
      JSON_MODE=1; shift;;
    --list)
      LIST_MODE=1; shift;;
    --stats)
      STATS_MODE=1; shift;;
    --dry-run)
      DRY_RUN=1; shift;;
    --quiet)
      QUIET=1; shift;;
    -h|--help)
      usage; exit 0;;
    --)
      shift
      # Validate extra args - only allow safe FrankenPHP arguments
      for arg in "$@"; do
        case "$arg" in
          *\;* | *\|* | *\&* | *\$* | *\`* | *\>* | *\<*)
            err "Invalid characters in extra arguments: $arg"; exit 2 ;;
        esac
      done
      EXTRA_ARGS=("$@")
      break;;
    *)
      err "Unknown option: $1"; usage; exit 2;;
  esac
done

# Modifier flags must never accidentally start a server or mutate during preview.
if [ "$STOP_ALL" -eq 1 ] && [ "$STOP_MODE" -eq 0 ]; then err "--all requires --stop"; exit 2; fi
if [ "$JSON_MODE" -eq 1 ] && [ "$LIST_MODE" -eq 0 ] && [ "$DOCTOR_MODE" -eq 0 ]; then err "--json requires --list or doctor"; exit 2; fi
if [ "$DOCTOR_MODE" -eq 1 ] && (( STOP_MODE || LIST_MODE || INIT_MODE || SAVE_MODE || INSTALL_MODE || BUILD_PHP_MODE || STATS_MODE || DRY_RUN || FORCE_MODE )); then
  err "doctor cannot be combined with another action (init, save, install, build, stop, list, stats, force or dry-run)"; exit 2
fi
if [ "$CONFIG_READ_ERROR" -eq 1 ] && [ "$DOCTOR_MODE" -eq 0 ]; then err "Cannot read $CONFIG_FILE"; exit 2; fi
if [ "$DRY_RUN" -eq 1 ] && { [ "$STOP_MODE" -eq 1 ] || [ "$INSTALL_MODE" -eq 1 ] || [ "$BUILD_PHP_MODE" -eq 1 ]; }; then
  err "--dry-run cannot be combined with --stop, --install or --build-php"; exit 2
fi

# Handle auto-domain detection
if [ "$AUTO_DOMAIN" -eq 1 ] && [ -z "$DOMAIN" ]; then
  DOMAIN=$(infer_domain)
  log "🔍 Auto-detected domain: $DOMAIN"
fi

# Helper to collect listeners for a PID
get_listeners_for_pid() {
  local pid="$1"
  if command_exists ss; then
    ss -Hlnpt 2>/dev/null | awk -v pid="$pid" '$0 ~ "pid="pid"," {print $4}' | sort -u
  elif command_exists lsof; then
    lsof -nP -iTCP -sTCP:LISTEN -p "$pid" 2>/dev/null | awk 'NR>1 {print $9}' | sort -u
  else
    echo "-"
  fi
}

# Cross-platform: get process command line
get_process_cmdline() {
  local pid="$1"
  if [ -f "/proc/$pid/cmdline" ]; then
    tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || echo ""
  else
    ps -p "$pid" -o args= 2>/dev/null || echo ""
  fi
}

# Cross-platform: get process working directory
get_process_cwd() {
  local pid="$1"
  if [ -L "/proc/$pid/cwd" ]; then
    readlink "/proc/$pid/cwd" 2>/dev/null || echo "-"
  elif command_exists lsof; then
    lsof -p "$pid" -Fn 2>/dev/null | awk -F'n' '/^n\// && /cwd/ {print $2; exit}' || echo "-"
  else
    echo "-"
  fi
}

# Cross-platform: check if PID is owned by current user
is_own_process() {
  local pid="$1"
  if [ -d "/proc/$pid" ]; then
    [ "$(get_file_owner_uid "/proc/$pid")" = "$(id -u)" ]
  else
    # macOS / BSD fallback: check via ps
    local owner_uid
    owner_uid=$(ps -p "$pid" -o uid= 2>/dev/null | tr -d ' ')
    [ "$owner_uid" = "$(id -u)" ]
  fi
}

# Helper to get process statistics
get_process_stats() {
  local pid="$1"

  # Try Linux /proc first
  if [ -f "/proc/$pid/stat" ] && [ -f "/proc/$pid/status" ]; then
    local stats_file="/proc/$pid/stat"
    local status_file="/proc/$pid/status"

    # Get process start time and calculate uptime
    local starttime=$(awk '{print $22}' "$stats_file" 2>/dev/null)
    local boot_time=$(awk '/^btime/ {print $2}' /proc/stat 2>/dev/null)
    local uptime_seconds=0

    if [ -n "$starttime" ] && [ -n "$boot_time" ]; then
      local clock_ticks=$(getconf CLK_TCK 2>/dev/null || echo 100)
      local process_start_time=$((boot_time + starttime / clock_ticks))
      local current_time=$(date +%s)
      uptime_seconds=$((current_time - process_start_time))
    fi

    # Format uptime
    local uptime_formatted
    if [ "$uptime_seconds" -lt 60 ]; then
      uptime_formatted="${uptime_seconds}s"
    elif [ "$uptime_seconds" -lt 3600 ]; then
      uptime_formatted="$((uptime_seconds / 60))m"
    else
      uptime_formatted="$((uptime_seconds / 3600))h"
    fi

    # Get memory usage (RSS in kB)
    local memory_kb=$(awk '/^VmRSS:/ {print $2}' "$status_file" 2>/dev/null || echo "0")
    local memory_mb=$((memory_kb / 1024))
    local memory_formatted
    if [ "$memory_mb" -ge 1024 ]; then
      memory_formatted="$((memory_mb / 1024))GB"
    else
      memory_formatted="${memory_mb}MB"
    fi

    # Get open file descriptor count
    local fd_count
    if [ -d "/proc/$pid/fd" ]; then
      fd_count=$(ls /proc/$pid/fd 2>/dev/null | wc -l)
    else
      fd_count="-"
    fi

    # Get thread count
    local threads=$(awk '/^Threads:/ {print $2}' "$status_file" 2>/dev/null || echo "-")

    echo "$uptime_formatted $memory_formatted $fd_count $threads"
  else
    # macOS / BSD fallback using ps
    local ps_output
    ps_output=$(ps -p "$pid" -o etime=,rss= 2>/dev/null)
    if [ -z "$ps_output" ]; then
      echo "- - - -"
      return
    fi

    local etime rss_kb
    etime=$(echo "$ps_output" | awk '{print $1}')
    rss_kb=$(echo "$ps_output" | awk '{print $2}')

    # Format elapsed time (ps gives [[dd-]hh:]mm:ss)
    local uptime_formatted="$etime"

    # Format memory
    local memory_mb=$(( (rss_kb + 512) / 1024 ))
    local memory_formatted
    if [ "$memory_mb" -ge 1024 ]; then
      memory_formatted="$((memory_mb / 1024))GB"
    else
      memory_formatted="${memory_mb}MB"
    fi

    echo "$uptime_formatted $memory_formatted - -"
  fi
}

# Helper: list running FrankenPHP instances owned by current user
list_instances() {
  log "🔎 Listing FrankenPHP processes for current user..."

  local PIDS
  PIDS=$(pgrep -f "frankenphp" -u "$(id -u)" 2>/dev/null || true)

  if [ -z "$PIDS" ]; then
    echo "No FrankenPHP processes found for current user."
    return 0
  fi


  # Print header
  printf "%s\n" "PID     LISTEN                MODE     STARTED FROM                        CONFIG"

  local pid cmdline config listeners mode docroot workdir
  for pid in $PIDS; do
    # Validate ownership
    if ! is_own_process "$pid"; then
      continue
    fi

    cmdline=$(get_process_cmdline "$pid")
    workdir=$(get_process_cwd "$pid")

    # Shorten path for display if too long
    if [ "${#workdir}" -gt 35 ] && [ "$workdir" != "-" ]; then
      workdir="...${workdir: -32}"
    fi

    # Extract --config value (best-effort)
    config=$(printf '%s' "$cmdline" | sed -n 's/.*--config \([^ ]\+\).*/\1/p')
    [ -z "$config" ] && config="-"

    # Shorten config path for display
    if [ "${#config}" -gt 25 ] && [ "$config" != "-" ]; then
      config="...${config: -22}"
    fi

    # Determine listeners
    listeners=$(get_listeners_for_pid "$pid" | paste -sd, -)
    [ -z "$listeners" ] && listeners="-"

    # Determine mode from config (best-effort)
    mode="-"
    if [ -f "$config" ]; then
      if grep -qE "^[[:space:]]*worker[[:space:]]*\{" "$config" 2>/dev/null; then
        mode="worker"
      else
        mode="classic"
      fi
    fi

    printf "%-7s %-20s %-8s %-35s %s\n" "$pid" "${listeners}" "$mode" "$workdir" "$config"
  done
}

# Show detailed statistics for running processes
stats_instances() {
  log "📊 Gathering statistics for FrankenPHP processes..."

  local PIDS
  PIDS=$(pgrep -f "frankenphp" -u "$(id -u)" 2>/dev/null || true)

  if [ -z "$PIDS" ]; then
    echo "No FrankenPHP processes found for current user."
    return 0
  fi

  # Print header
  printf "%s\n" "PID     LISTEN           MODE     UPTIME  MEMORY  FILES THREADS  STARTED FROM"

  local pid cmdline config listeners mode workdir stats_info
  for pid in $PIDS; do
    # Validate ownership
    if ! is_own_process "$pid"; then
      continue
    fi

    cmdline=$(get_process_cmdline "$pid")
    workdir=$(get_process_cwd "$pid")
    if [ "${#workdir}" -gt 25 ] && [ "$workdir" != "-" ]; then
      workdir="...${workdir: -22}"
    fi

    # Extract config
    config=$(printf '%s' "$cmdline" | sed -n 's/.*--config \([^ ]\+\).*/\1/p')
    [ -z "$config" ] && config="-"

    # Determine listeners
    listeners=$(get_listeners_for_pid "$pid" | paste -sd, -)
    [ -z "$listeners" ] && listeners="-"
    if [ "${#listeners}" -gt 15 ]; then
      listeners="${listeners:0:12}..."
    fi

    # Determine mode
    mode="-"
    if [ -f "$config" ]; then
      if grep -qE "^[[:space:]]*worker[[:space:]]*\{" "$config" 2>/dev/null; then
        mode="worker"
      else
        mode="classic"
      fi
    fi

    # Get statistics
    stats_info=$(get_process_stats "$pid")

    printf "%-7s %-15s %-8s %s  %s\n" "$pid" "${listeners}" "$mode" "$stats_info" "$workdir"
  done
}

# Only processes started by phpup are eligible for management. A start token
# prevents a stale PID file from targeting an unrelated process after PID reuse.
process_token() {
  if [ -r "/proc/$1/stat" ]; then
    awk '{sub(/^.*\) /, ""); if ($1 != "Z") print "linux:" $20}' "/proc/$1/stat" 2>/dev/null
    return
  fi
  ps -p "$1" -o lstart= 2>/dev/null | sed 's/^[[:space:]]*//'
}

registry_dir() {
  printf '%s/phpup-%s' "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}" "$(id -u)"
}

json_string() {
  local value="$1" char escaped i
  value="${value//\\/\\\\}"; value="${value//\"/\\\"}"
  for ((i=1; i<32; i++)); do
    printf -v char '%b' "\\$(printf '%03o' "$i")"
    printf -v escaped '\\u%04x' "$i"
    value="${value//"$char"/"$escaped"}"
  done
  printf '"%s"' "$value"
}

APP_ENV=()
load_app_env() {
  local file="$1" line key value
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" =~ ^[a-zA-Z_][a-zA-Z0-9_]*= ]] || continue
    key="${line%%=*}"; value="${line#*=}"
    if [ "${#value}" -ge 2 ] && [[ "$value" == \"*\" || "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; fi
    APP_ENV+=("$key=$value")
  done < "$file"
}

# Diagnostics collect evidence only: no provisioning, config writes or app scripts.
doctor_add() {
  local id="$1" status="$2" title="$3" message="$4" fix="${5:-}" row
  row=$(printf '{"id":'; json_string "$id"; printf ',"status":'; json_string "$status";
    printf ',"title":'; json_string "$title"; printf ',"message":'; json_string "$message";
    printf ',"fix":'; if [ -n "$fix" ]; then json_string "$fix"; else printf null; fi; printf '}')
  doctor_record "$status" "$row" "$title" "$message" "$fix"
}

doctor_record() {
  local status="$1" row="$2"
  case "$status" in
    error) DOCTOR_ERRORS=$((DOCTOR_ERRORS + 1)) ;;
    warning) DOCTOR_WARNINGS=$((DOCTOR_WARNINGS + 1)) ;;
    pass) DOCTOR_PASSES=$((DOCTOR_PASSES + 1)) ;;
    *) return 1 ;;
  esac
  DOCTOR_ROWS+=("$row")
  DOCTOR_TEXT+=("[$status] ${3:-}: ${4:-}")
  [ -z "${5:-}" ] || DOCTOR_TEXT+=("  Fix: $5")
  return 0
}

run_doctor() {
  local DOCTOR_ERRORS=0 DOCTOR_WARNINGS=0 DOCTOR_PASSES=0
  local -a DOCTOR_ROWS=() DOCTOR_TEXT=() probe_env=() probe_timeout=()
  local project dir scan scan_set startup="" runtime_bin="" runtime_ok=0 config_ok=1 key value file output status row title message fix first=1 ca cert certkey public_cert public_key
  project=$(pwd -P)
  command_exists timeout && probe_timeout=("$(command -v timeout)" 15s)
  if [ "$CONFIG_READ_ERROR" -eq 1 ]; then
    doctor_add config error 'Saved settings' "Cannot read $CONFIG_FILE" 'Restore read access to .phpup/config.'
    config_ok=0
  else
    for key in HOST START_PORT PHP_THREADS MAX_WAIT_TIME DOMAIN HTTPS_MODE WORKER_MODE WATCH_MODE COMPRESSION OPEN_BROWSER XDEBUG; do
      value="${!key}"
      case "$key" in
        HOST) validate_host "$value" ;;
        START_PORT) validate_port "$value" ;;
        PHP_THREADS) validate_threads "$value" ;;
        MAX_WAIT_TIME) validate_time "$value" ;;
        DOMAIN) [ -z "$value" ] || validate_domain "$value" ;;
        HTTPS_MODE) [[ "$value" = off || "$value" = local || "$value" = on ]] ;;
        *) [[ "$value" = 0 || "$value" = 1 ]] ;;
      esac && continue
      doctor_add "config.$key" error 'Saved settings' "Invalid $key: $value" 'Correct .phpup/config or override this setting on the command line.'
      config_ok=0
    done
    if [ "$WATCH_MODE" = 1 ] && [ "$WORKER_MODE" != 1 ]; then
      doctor_add config.watch error 'Worker watch' 'Watching requires worker mode.' 'Enable worker mode with a compatible worker script, or disable watching.'
      config_ok=0
    fi
    if [ "$config_ok" = 1 ]; then
      if [ -f "$CONFIG_FILE" ]; then doctor_add config pass 'Saved settings' 'Saved settings are valid.';
      else doctor_add config pass 'Settings' 'Using defaults; no saved configuration.'; fi
    fi
  fi
  if [ -z "$DOCROOT" ]; then
    for dir in public web www .; do [ ! -d "$dir" ] || { DOCROOT="$dir"; break; }; done
  fi
  if validate_file_path "$DOCROOT" false && [ -d "$DOCROOT" ] && [ -r "$DOCROOT" ] && [ -x "$DOCROOT" ]; then
    DOCROOT=$(cd "$DOCROOT" && pwd -P)
    doctor_add docroot pass 'Document root' "$DOCROOT"
  else doctor_add docroot error 'Document root' "Directory is missing, unreadable or invalid: $DOCROOT" 'Set DOCROOT to an existing readable directory in .phpup/config.'; fi
  if [ "$WORKER_MODE" = 1 ] && [ ! -r "$DOCROOT/index.php" ] && [ ! -r "$DOCROOT/app.php" ]; then
    doctor_add worker error 'Worker script' 'Neither index.php nor app.php is readable in the document root.' 'Set the document root to the directory containing your worker entry point.'
  fi
  dir="$project/.phpup"
  [ -e "$dir" ] || dir="$project"
  if [ -d "$dir" ] && [ -w "$dir" ] && [ -x "$dir" ]; then doctor_add storage pass 'Project storage' "$dir is writable.";
  else doctor_add storage error 'Project storage' "Cannot write runtime files in $dir" 'Restore write and directory access for your user.'; fi
  dir=$(registry_dir)
  if [ -L "$dir" ] || { [ -e "$dir" ] && { [ ! -d "$dir" ] || [ ! -w "$dir" ] || [ "$(get_file_owner_uid "$dir")" != "$(id -u)" ]; }; }; then
    doctor_add registry error 'Process registry' "Unsafe or inaccessible registry: $dir" 'Use a private, writable XDG_RUNTIME_DIR owned by your user.'
  elif [ ! -e "$dir" ] && [ ! -w "$(dirname "$dir")" ]; then
    doctor_add registry error 'Process registry' "Registry parent is not writable: $(dirname "$dir")" 'Set XDG_RUNTIME_DIR to an existing writable directory.'
  else doctor_add registry pass 'Process registry' "$dir is available."; fi
  if command_exists curl; then doctor_add curl pass 'HTTP readiness' 'curl is available.';
  else doctor_add curl error 'HTTP readiness' 'curl is missing; server readiness cannot be checked.' 'Install curl with your system package manager.'; fi
  if validate_port "$START_PORT"; then
    if command_exists ss || command_exists lsof || command_exists nc; then
      if is_port_free "$HOST" "$START_PORT"; then doctor_add port pass 'Requested port' "Port $START_PORT is available.";
      else doctor_add port warning 'Requested port' "Port $START_PORT is occupied. A new launch will choose the next available port." 'Stop the existing server or choose another port if you need a fixed URL.'; fi
    else doctor_add port warning 'Requested port' 'No supported listener inspection tool is available.' 'Install ss (iproute), lsof or nc to inspect occupied ports.'; fi
  fi
  local -a APP_ENV=()
  for file in "$project/.phpup/.env" "$ENV_FILE"; do
    [ -n "$file" ] || continue
    if { [ -e "$file" ] || [ "$file" = "$ENV_FILE" ]; } && [ ! -r "$file" ]; then
      doctor_add "env.$file" error 'Application environment' "Cannot read $file" 'Restore read access or correct --env-file.'
    else load_app_env "$file"; fi
  done
  probe_env=("${APP_ENV[@]}" "PHPUP_DIR=$project/.phpup" "PHPUP_DOCTOR_XDEBUG=$XDEBUG")
  scan="${PHP_INI_SCAN_DIR-}"
  scan_set="${PHP_INI_SCAN_DIR+x}"
  if [ -f "$project/.phpup/php.ini" ]; then
    if [ "${PHP_INI_SCAN_DIR+x}" = x ] && [ -z "$scan" ]; then scan="$project/.phpup"; else scan="$scan:$project/.phpup"; fi
    scan_set=x
  else
    for value in "${APP_ENV[@]}"; do
      case "$value" in PHP_INI_SCAN_DIR=*) scan="${value#*=}"; scan_set=x ;; esac
    done
  fi
  if command_exists frankenphp && DOCTOR_TMP=$(mktemp -d "${TMPDIR:-/tmp}/phpup-doctor-ini.XXXXXX"); then
    # php-cli before PHP 8.6 cannot accept -d. A final temporary INI prevents
    # startup diagnostics from writing to the project-configured error log.
    printf 'log_errors=Off\ndisplay_errors=stderr\ndisplay_startup_errors=On\n' > "$DOCTOR_TMP/phpup-doctor.ini"
    if [ "$scan_set" = x ] && [ -z "$scan" ]; then scan="$DOCTOR_TMP"; else scan="$scan:$DOCTOR_TMP"; fi
    probe_env+=("PHP_INI_SCAN_DIR=$scan" "PHPUP_DOCTOR_INI=$DOCTOR_TMP/phpup-doctor.ini")
    runtime_bin=$(command -v frankenphp)
    if output=$(env "${probe_env[@]}" "${probe_timeout[@]}" "$runtime_bin" php-cli -r '
function report($id, $status, $title, $message, $fix = null) {
    echo $status, "\t", json_encode(compact("id", "status", "title", "message", "fix"), JSON_INVALID_UTF8_SUBSTITUTE | JSON_UNESCAPED_SLASHES), "\t", str_replace("\0", "\t", str_replace(["\n", "\r", "\t"], " ", $title . "\0" . $message . "\0" . ($fix ?? ""))), "\n";
}
if (getenv("PHPUP_DOCTOR_XDEBUG") === "1" && !extension_loaded("xdebug")) report("xdebug", "error", "Xdebug", "Xdebug is enabled in settings but is not loaded in FrankenPHP.", "Install a FrankenPHP build containing Xdebug or disable XDEBUG in .phpup/config.");
report("runtime", "pass", "FrankenPHP runtime", "PHP " . PHP_VERSION . " · " . count(get_loaded_extensions()) . " extensions loaded.");
$ini = implode(", ", array_filter(array_map("trim", explode(",", php_ini_scanned_files() ?: "")), fn($f) => $f !== getenv("PHPUP_DOCTOR_INI")));
$main = php_ini_loaded_file() ?: "none";
report("ini", "pass", "PHP configuration", "Main: " . $main . "; scanned: " . (trim($ini) ?: "none"));
$requirements = [];
if (is_file("composer.json")) {
    try {
        $manifest = json_decode(file_get_contents("composer.json"), true, 512, JSON_THROW_ON_ERROR);
        if (!is_array($manifest)) throw new Exception("Expected an object");
        report("composer.manifest", "pass", "Composer manifest", "composer.json is valid JSON.");
        foreach (["require", "require-dev"] as $section) {
            if (isset($manifest[$section]) && !is_array($manifest[$section])) throw new Exception("Invalid " . $section);
            $requirements += $manifest[$section] ?? [];
        }
        $vendor = $manifest["config"]["vendor-dir"] ?? "vendor";
        if (!is_string($vendor) || $vendor === "" || preg_match("/[\x00-\x1f]/", $vendor)) throw new Exception("Invalid vendor-dir");
        $installed = is_readable($vendor . "/autoload.php");
        report("composer.vendor", $installed ? "pass" : "warning", "Composer dependencies", $installed ? "Autoloader found in " . $vendor : "Missing " . $vendor . "/autoload.php", $installed ? null : "Run composer install in this project.");
    } catch (Throwable $error) {
        report("composer.manifest.invalid", "error", "Composer manifest", $error->getMessage(), "Correct composer.json before installing dependencies.");
    }
}
if (is_file("composer.lock")) {
    try {
        $lock = json_decode(file_get_contents("composer.lock"), true, 512, JSON_THROW_ON_ERROR);
        if (!is_array($lock)) throw new Exception("Expected an object");
        foreach (["packages", "packages-dev"] as $section) {
            foreach ($lock[$section] ?? [] as $package) $requirements += $package["require"] ?? [];
        }
        foreach (["platform", "platform-dev"] as $section) $requirements += $lock[$section] ?? [];
    } catch (Throwable $error) {
        report("composer.lock", "error", "Composer lock", "Cannot read locked requirements: " . $error->getMessage(), "Restore or regenerate composer.lock with Composer.");
    }
}
$missing = [];
foreach (array_keys($requirements) as $name) {
    if (str_starts_with($name, "ext-") && !extension_loaded(str_replace("-", "_", substr($name, 4)))) $missing[] = $name;
}
if ($missing) report("extensions", "error", "Required PHP extensions", "Missing: " . implode(", ", $missing), "Install or build FrankenPHP with these extensions, then check again.");
elseif ($requirements) report("extensions", "pass", "Required PHP extensions", "All declared extension names are loaded. Version constraints are not evaluated.");
if (isset($requirements["php"])) report("php.constraint", "warning", "PHP version constraints", "Runtime is " . PHP_VERSION . "; declared PHP requirement: " . (string)$requirements["php"] . ". Full version constraints are not evaluated.", "Run composer check-platform-reqs using this FrankenPHP runtime after installing dependencies.");
' 2>&1); then
      runtime_ok=1
      while IFS=$'\t' read -r status row title message fix; do
        case "$status" in
          pass|warning|error) doctor_record "$status" "$row" "$title" "$message" "$fix" ;;
          '') ;;
          *) startup+="$status $row " ;;
        esac
      done <<< "$output"
      if [ -n "$startup" ]; then doctor_add runtime.startup warning 'PHP startup messages' "${startup:0:1200}" 'Review the PHP configuration and loaded extensions.'; fi
    else doctor_add runtime error 'FrankenPHP runtime' 'PHP inspection failed or timed out.' 'Run frankenphp php-cli -r '\''echo PHP_VERSION;'\'' and check .phpup/php.ini for startup errors.'; fi
  elif command_exists frankenphp; then doctor_add runtime error 'FrankenPHP runtime' 'Cannot create temporary diagnostic configuration.' 'Set TMPDIR to an existing writable directory.'
  else doctor_add runtime error 'FrankenPHP runtime' 'frankenphp is missing from PATH.' 'Run phpup --install or install FrankenPHP, then reopen your terminal.'; fi
  if [ -f composer.json ]; then
    if command_exists composer || { [ "$runtime_ok" = 1 ] && [ -r "$HOME/.local/bin/composer.phar" ]; }; then
      doctor_add composer pass Composer 'Composer is available.'
    else doctor_add composer warning Composer 'Composer is missing.' 'Install Composer from getcomposer.org or the desktop Tools panel.'; fi
  fi
  if [ -f package.json ] && [ ! -d node_modules ]; then
    doctor_add node.dependencies warning 'Frontend dependencies' 'package.json exists but node_modules is missing.' 'Install dependencies with the package manager matching this project’s lockfile.'
  fi
  if [ -z "$CADDYFILE" ]; then
    for file in .phpup/Caddyfile Caddyfile.local Caddyfile.dev Caddyfile caddy/Caddyfile config/Caddyfile .Caddyfile; do
      [ ! -f "$file" ] || { CADDYFILE="$file"; break; }
    done
  fi
  if [ -n "$CADDYFILE" ]; then
    doctor_add caddy.custom warning 'Custom Caddyfile' "$CADDYFILE controls listeners and PHP options; saved settings may be overridden." 'Review this file when the server differs from saved settings.'
    if [ "$runtime_ok" = 1 ] && [ "$config_ok" = 1 ]; then
      local protocol=http site="${DOMAIN:-$HOST}" worker="$DOCROOT/index.php"
      [ "$HTTPS_MODE" = off ] || protocol=https
      [ "$site" != ::1 ] || site='[::1]'
      [ ! -f "$DOCROOT/app.php" ] || worker="$DOCROOT/app.php"
      if output=$(env "${probe_env[@]}" "HOST=$site" "PORT=$START_PORT" "DOCROOT=$DOCROOT" "PROTOCOL=$protocol" "SERVER_NAME=$site:$START_PORT" "SERVER_ROOT=$DOCROOT" "DOCUMENT_ROOT=$DOCROOT" "WORKER_FILE=$worker" "PHP_THREADS=$PHP_THREADS" "MAX_WAIT_TIME=$MAX_WAIT_TIME" "${probe_timeout[@]}" "$runtime_bin" adapt --adapter caddyfile --config "$CADDYFILE" 2>&1 >/dev/null); then
        doctor_add caddy.syntax pass 'Caddyfile syntax' 'Adapted successfully. Runtime provisioning is checked when starting.'
      else doctor_add caddy.syntax error 'Caddyfile syntax' "${output:0:1200}" 'Fix the custom Caddyfile and check again.'; fi
    fi
  fi
  if [ -n "$DOMAIN" ] && validate_domain "$DOMAIN"; then
    if awk -v domain="$DOMAIN" '$1 == "127.0.0.1" || $1 == "::1" {for (i=2;i<=NF && $i !~ /^#/;i++) if ($i == domain) found=1} END {exit !found}' /etc/hosts; then
      doctor_add hosts pass 'Local hostname' "$DOMAIN has a loopback entry in /etc/hosts."
    else doctor_add hosts warning 'Local hostname' "No loopback hosts entry for $DOMAIN. DNS was not checked." 'Add a loopback hosts entry or configure local DNS; starting with hosts management may request permission.'; fi
  fi
  if [ "$HTTPS_MODE" = local ]; then
    if [ -z "$DOMAIN" ]; then doctor_add tls.domain warning 'Local HTTPS' 'Without a custom domain, Caddy manages the local certificate. Trust has not been verified.' 'For mkcert-managed HTTPS, set DOMAIN to a local name such as myapp.test.';
    elif validate_domain "$DOMAIN"; then
      if command_exists mkcert; then
        doctor_add mkcert pass 'Local certificate tool' 'mkcert is available.'
        ca=$(mkcert -CAROOT 2>/dev/null || true)
        if [ -r "$ca/rootCA.pem" ]; then
          doctor_add tls.ca warning 'Local certificate authority' 'A local CA exists. Browser and system trust have not been verified.' 'If your browser rejects HTTPS, run mkcert -install as your normal user and restart the browser.'
        else doctor_add tls.ca warning 'Local certificate authority' 'No readable local CA certificate was found.' 'Run mkcert -install as your normal user to create and trust a local CA.'; fi
      else doctor_add mkcert error 'Local certificate tool' 'mkcert is missing; local HTTPS cannot generate certificates.' 'Install mkcert, then run mkcert -install as your normal user.'; fi
      cert="$project/.phpup/certs/$DOMAIN.pem"; certkey="$project/.phpup/certs/$DOMAIN-key.pem"
      if [ ! -f "$cert" ] || [ ! -f "$certkey" ]; then
        doctor_add tls.cert warning 'Project certificate' 'A certificate and key have not been generated yet.' 'Start the project after configuring mkcert to generate its certificate.'
      elif command_exists openssl; then
        public_cert=$(openssl x509 -in "$cert" -pubkey -noout 2>/dev/null || true)
        public_key=$(openssl pkey -in "$certkey" -pubout -passin pass: 2>/dev/null || true)
        if [ -n "$public_cert" ] && [ "$public_cert" = "$public_key" ] && openssl x509 -in "$cert" -checkend 0 -noout >/dev/null 2>&1 && openssl x509 -in "$cert" -checkhost "$DOMAIN" -noout >/dev/null 2>&1; then
          doctor_add tls.cert pass 'Project certificate' 'Certificate is unexpired, matches the domain and matches its private key.'
        else doctor_add tls.cert error 'Project certificate' 'Certificate is expired, invalid, for another hostname, or does not match the key.' 'Back up and remove this project’s certificate and key, then restart to regenerate them.'; fi
      else doctor_add tls.cert warning 'Project certificate' 'Certificate files exist; openssl is unavailable to inspect them.' 'Install openssl to check expiry, hostname and key pairing.'; fi
    fi
  fi
  if [ "$JSON_MODE" = 1 ]; then
    printf '{"schemaVersion":1,"project":'; json_string "$project"
    printf ',"ok":'; if [ "$DOCTOR_ERRORS" = 0 ]; then printf true; else printf false; fi
    printf ',"summary":{"errors":%s,"warnings":%s,"passes":%s},"checks":[' "$DOCTOR_ERRORS" "$DOCTOR_WARNINGS" "$DOCTOR_PASSES"
    for row in "${DOCTOR_ROWS[@]}"; do [ "$first" = 1 ] || printf ','; first=0; printf '%s' "$row"; done
    printf ']}\n'
  else
    printf 'PHPUp doctor — %s\n' "$project"
    # Render the same rows without requiring PHP, jq or Python to be installed.
    printf '%s errors, %s warnings, %s passed\n' "$DOCTOR_ERRORS" "$DOCTOR_WARNINGS" "$DOCTOR_PASSES"
    printf '%s\n' "${DOCTOR_TEXT[@]}"
  fi
  [ "$DOCTOR_ERRORS" = 0 ]
}

