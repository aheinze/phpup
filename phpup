# A single renderer serves initialization examples, dry runs and live launches.
render_caddyfile() {
  local worker="$1" threads="$PHP_THREADS"
  if [ "$threads" = auto ]; then threads=2; fi
  printf '# Generated by phpup. Runtime files are replaced each launch.\n'
  printf '# Document root: %s\n# HOST=%s PORT=%s DOCROOT=%s\n' "$DOCROOT" "$HOST" "$PORT" "$DOCROOT"
  printf '{\n  admin off\n'
  [ "$HTTPS_MODE" != off ] || printf '  auto_https off\n'
  [ "$HTTPS_MODE" != local ] || printf '  local_certs\n'
  printf '  frankenphp {\n    num_threads %s\n    max_wait_time %s\n' "$threads" "$MAX_WAIT_TIME"
  [ "$PHP_THREADS" != auto ] || printf '    max_threads 10\n'
  if [ ! -f "$PHPUP_DIR/php.ini" ]; then
    cat <<'EOF'
    php_ini {
      memory_limit 256M
      max_execution_time 60
      upload_max_filesize 50M
      post_max_size 50M
      display_errors On
      error_reporting E_ALL
      log_errors On
      opcache.validate_timestamps 1
      opcache.revalidate_freq 0
      session.save_path "\"${PHPUP_DIR}/sessions\""
      error_log "\"${PHPUP_DIR}/php_errors.log\""
    }
EOF
  fi
  if [ "$XDEBUG" -eq 1 ]; then
    printf '    php_ini xdebug.mode debug\n    php_ini xdebug.start_with_request yes\n    php_ini xdebug.client_host 127.0.0.1\n    php_ini xdebug.client_port 9003\n'
  fi
  if [ "$worker" -eq 1 ]; then
    printf '    worker {\n      file '; caddy_quote "$WORKER_FILE"; printf '\n      num 2\n'
    if [ "$WATCH_MODE" -eq 1 ]; then
      printf '      watch "**/*.php"\n'
      local pattern
      local -a patterns=()
      IFS=',' read -r -a patterns <<< "$WATCH_PATTERNS"
      for pattern in "${patterns[@]}"; do
        [ -z "$pattern" ] || { printf '      watch '; caddy_quote "$pattern"; printf '\n'; }
      done
    fi
    printf '    }\n'
  fi
  printf '  }\n}\n\n%s://%s:%s {\n  bind %s\n  root * ' "$PROTOCOL" "$SITE_HOST" "$PORT" "$BIND_HOST"
  caddy_quote "$DOCROOT"; printf '\n'
  if [ "$HTTPS_MODE" = local ] && [ -n "$DOMAIN" ]; then
    printf '  tls '; caddy_quote "$PHPUP_DIR/certs/$DOMAIN.pem"; printf ' '; caddy_quote "$PHPUP_DIR/certs/$DOMAIN-key.pem"; printf '\n'
  fi
  [ "$COMPRESSION" -ne 1 ] || printf '  encode zstd gzip\n'
  cat <<'EOF'
  # Reject private project files before rewriting or serving PHP/static content.
  route {
    @private path_regexp private (?i)(^|/)\.[^/]+|(^|/)(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml(\.dist)?|php\.ini|Caddyfile[^/]*)(/|$)
    respond @private 404
    @subapp {
      not file {path}
      path_regexp subapp ^/([^/]+)/(.*)$
      file {re.subapp.1}/index.php
    }
    rewrite @subapp /{re.subapp.1}/index.php
    php_server
  }
  header Cache-Control "no-store"
  log {
EOF
  printf '    output file '; caddy_quote "$PHPUP_DIR/access.log"; printf ' {\n'
  cat <<'EOF'
      roll_size 10mb
      roll_keep 3
    }
    format json
  }
}
EOF
}

if [ "$DRY_RUN" -eq 1 ] && [ "$INIT_MODE" -eq 1 ]; then
  echo 'DRY-RUN: would initialize .phpup/config, php.ini and Caddyfile examples'
  exit 0
fi
if [ "$INIT_MODE" -eq 1 ]; then
  mkdir -p "$PHPUP_DIR/sessions"
  chmod 700 "$PHPUP_DIR"
  if [ ! -f "$PHPUP_DIR/php.ini" ] || [ "$FORCE_MODE" -eq 1 ]; then
    ini_tmp=$(mktemp "$PHPUP_DIR/php.ini.XXXXXX")
    cat > "$ini_tmp" <<'EOF'
; Project PHP settings, loaded in addition to the system PHP configuration.
memory_limit = 256M
max_execution_time = 60
upload_max_filesize = 50M
post_max_size = 50M
display_errors = On
error_reporting = E_ALL
log_errors = On
error_log = "${PHPUP_DIR}/php_errors.log"
session.save_path = "${PHPUP_DIR}/sessions"
opcache.validate_timestamps = 1
opcache.revalidate_freq = 0
EOF
    mv -f "$ini_tmp" "$PHPUP_DIR/php.ini"
  fi
  for mode in classic worker; do
    file="$PHPUP_DIR/Caddyfile.$mode"
    if [ ! -f "$file" ] || [ "$FORCE_MODE" -eq 1 ]; then
      tmp=$(mktemp "$PHPUP_DIR/Caddyfile.XXXXXX")
      worker=0; [ "$mode" != worker ] || worker=1
      render_caddyfile "$worker" > "$tmp"
      mv -f "$tmp" "$file"
    fi
  done
  if [ ! -f "$CONFIG_FILE" ] || [ "$SAVE_MODE" -eq 1 ] || [ "$FORCE_MODE" -eq 1 ]; then save_config; fi
  log "Initialized .phpup/config and php.ini. Caddyfile.classic/worker are examples."
  log "Normal launches regenerate runtime config. Use --caddyfile to opt into a custom file."
  exit 0
fi

command_exists frankenphp || { err "'frankenphp' binary not found in PATH"; exit 127; }
FRANKENPHP_BIN=$(command -v frankenphp)

load_app_env "$PHPUP_DIR/.env"
if [ -n "$ENV_FILE" ]; then
  [ -r "$ENV_FILE" ] || { err "Environment file is not readable: $ENV_FILE"; exit 2; }
  load_app_env "$ENV_FILE"
fi

# Explicit/custom files remain user-owned. Never silently overwrite or migrate them.
if [ -z "$CADDYFILE" ]; then
  for file in .phpup/Caddyfile Caddyfile.local Caddyfile.dev Caddyfile caddy/Caddyfile config/Caddyfile .Caddyfile; do
    if [ -f "$file" ]; then CADDYFILE="$file"; break; fi
  done
fi
if [ -n "$CADDYFILE" ]; then
  validate_file_path "$CADDYFILE" true || { err "Caddyfile not found or invalid: $CADDYFILE"; exit 2; }
  CADDYFILE="$(cd "$(dirname "$CADDYFILE")" && pwd -P)/$(basename "$CADDYFILE")"
fi

PORT=$(find_free_port "$BIND_HOST" "$START_PORT") || { err "No free port at or above $START_PORT"; exit 1; }
SERVER_NAME="$SITE_HOST:$PORT"
SERVER_URL="$PROTOCOL://$SERVER_NAME"
export HOST PORT DOCROOT PROTOCOL WORKER_FILE PHPUP_DIR PHP_THREADS
export SERVER_NAME SERVER_ROOT="$DOCROOT" DOCUMENT_ROOT="$DOCROOT" MAX_WAIT_TIME
RUN_ENV=("${APP_ENV[@]}" "HOST=$SITE_HOST" "PORT=$PORT" "DOCROOT=$DOCROOT" "PROTOCOL=$PROTOCOL" "PHPUP_DIR=$PHPUP_DIR" "WORKER_FILE=$WORKER_FILE" "SERVER_NAME=$SERVER_NAME" "SERVER_ROOT=$DOCROOT" "DOCUMENT_ROOT=$DOCROOT" "PHP_THREADS=$PHP_THREADS" "MAX_WAIT_TIME=$MAX_WAIT_TIME")
if [ -f "$PHPUP_DIR/php.ini" ]; then
  PHP_SCAN="${PHP_INI_SCAN_DIR-}"
  if [ "${PHP_INI_SCAN_DIR+x}" = x ] && [ -z "$PHP_SCAN" ]; then
    PHP_SCAN="$PHPUP_DIR"
  else
    PHP_SCAN="$PHP_SCAN:$PHPUP_DIR"
  fi
  RUN_ENV+=("PHP_INI_SCAN_DIR=$PHP_SCAN")
fi
if [ "$DRY_RUN" -eq 1 ]; then
  echo 'DRY-RUN'
  echo "URL: $SERVER_URL"
  echo "Docroot: $DOCROOT"
  echo "PHP threads: $PHP_THREADS"
  echo "Worker mode: $WORKER_MODE; File watcher: $WATCH_MODE"
  if [ -n "$CADDYFILE" ]; then
    echo "Caddyfile: $CADDYFILE (custom; its directives determine actual listeners/options)"
  else
    echo 'Caddyfile: generated at launch'
    [ "$VERBOSE" -ne 1 ] || render_caddyfile "$WORKER_MODE"
  fi
  printf 'Command: frankenphp run --config %q\n' "${CADDYFILE:-$PHPUP_DIR/runtime/Caddyfile}"
  [ "$SAVE_MODE" -ne 1 ] || echo 'Would save .phpup/config'
  exit 0
fi

command_exists curl || { err "curl is required to verify server readiness"; exit 127; }
if [ "$WORKER_MODE" -eq 1 ] && [ ! -f "$WORKER_FILE" ]; then err "Worker script not found: $WORKER_FILE"; exit 2; fi
mkdir -p "$PHPUP_DIR/runtime" "$PHPUP_DIR/sessions"
secure_files

cleanup() {
  local status=$?
  trap - EXIT INT TERM HUP
  [ -z "${TAIL_PID:-}" ] || kill "$TAIL_PID" 2>/dev/null || true
  if [ -n "$FRANKENPHP_PID" ] && [ -n "$FRANKENPHP_TOKEN" ] && [ "$(process_token "$FRANKENPHP_PID")" = "$FRANKENPHP_TOKEN" ]; then
    kill -TERM "$FRANKENPHP_PID" 2>/dev/null || true
    for _ in $(seq 1 50); do
      [ "$(process_token "$FRANKENPHP_PID")" = "$FRANKENPHP_TOKEN" ] || break
      sleep 0.1
    done
    if [ "$(process_token "$FRANKENPHP_PID")" = "$FRANKENPHP_TOKEN" ]; then kill -KILL "$FRANKENPHP_PID" 2>/dev/null || true; fi
    wait "$FRANKENPHP_PID" 2>/dev/null || true
  fi
  [ -z "$STATE_FILE" ] || rm -f "$STATE_FILE"
  [ -z "$RUNTIME_TMP" ] || rm -f "$RUNTIME_TMP"
  if [ "$HOSTS_ENTRY_ADDED" -eq 1 ]; then manage_hosts_entry remove "$DOMAIN" 127.0.0.1 || true; fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

if [ -n "$DOMAIN" ]; then
  if [ "$HTTPS_MODE" = local ]; then
    check_mkcert || setup_mkcert || { err "Local HTTPS requires mkcert; setup failed"; exit 1; }
    generate_cert "$DOMAIN" || { err "Certificate generation failed"; exit 1; }
  fi
  if [ "$MANAGE_HOSTS" -eq 1 ]; then manage_hosts_entry add "$DOMAIN" 127.0.0.1 || exit 1; fi
fi
if [ "$SAVE_MODE" -eq 1 ]; then save_config; fi
if [ -n "$CADDYFILE" ]; then
  FINAL_CADDYFILE="$CADDYFILE"
  log "Using custom Caddyfile: $CADDYFILE (its directives control listeners and options)."
else
  RUNTIME_TMP=$(mktemp "$PHPUP_DIR/runtime/Caddyfile.XXXXXX")
  render_caddyfile "$WORKER_MODE" > "$RUNTIME_TMP"
  FINAL_CADDYFILE="$RUNTIME_TMP"
fi
# Always retain real diagnostics. A failed config never launches a server.
if ! env "${RUN_ENV[@]}" "$FRANKENPHP_BIN" validate --config "$FINAL_CADDYFILE" --adapter caddyfile > "$PHPUP_DIR/runtime/validation.log" 2>&1; then
  cat "$PHPUP_DIR/runtime/validation.log" >&2
  exit 1
fi
SERVER_LOG="$PHPUP_DIR/runtime/server-$$.log"
log "Starting FrankenPHP at $SERVER_URL"
env "${RUN_ENV[@]}" "$FRANKENPHP_BIN" run --config "$FINAL_CADDYFILE" --adapter caddyfile "${EXTRA_ARGS[@]}" > "$SERVER_LOG" 2>&1 &
FRANKENPHP_PID=$!
FRANKENPHP_TOKEN=$(process_token "$FRANKENPHP_PID") || true
# An HTTP response, including an application 4xx/5xx, proves the listener is up.
# A successful application response is not required to preserve error debugging.
READY=0
PROBE_HOST="$BIND_HOST"
[ "$PROBE_HOST" != 0.0.0.0 ] || PROBE_HOST=127.0.0.1
for _ in $(seq 1 30); do
  if ! kill -0 "$FRANKENPHP_PID" 2>/dev/null; then break; fi
  probe_args=(--silent --noproxy '*' --max-time 1 --output /dev/null)
  if [ "$SITE_HOST" != '[::1]' ]; then
    [ "$PROBE_HOST" != ::1 ] || PROBE_HOST='[::1]'
    probe_args+=(--resolve "$SITE_HOST:$PORT:$PROBE_HOST")
  fi
  [ "$HTTPS_MODE" != local ] || probe_args+=(--insecure)
  if curl "${probe_args[@]}" "$SERVER_URL/" && kill -0 "$FRANKENPHP_PID" 2>/dev/null; then READY=1; break; fi
  sleep 0.1
 done
if [ "$READY" -ne 1 ]; then
  err "Server did not become ready at $SERVER_URL"
  tail -40 "$SERVER_LOG" >&2
  exit 1
fi
REGISTRY=$(registry_dir)
if [ -L "$REGISTRY" ]; then err "Invalid runtime registry"; exit 1; fi
mkdir -p "$REGISTRY"
[ "$(get_file_owner_uid "$REGISTRY")" = "$(id -u)" ] || { err "Runtime registry has another owner"; exit 1; }
chmod 700 "$REGISTRY"
STATE_FILE="$REGISTRY/$$.state"
state_tmp=$(mktemp "$REGISTRY/.state.XXXXXX")
printf '%s\n' "$$" "$(process_token $$)" "$PROJECT_PATH" "$PORT" "$SERVER_URL" "$FRANKENPHP_PID" "$(process_token "$FRANKENPHP_PID")" > "$state_tmp"
mv -f "$state_tmp" "$STATE_FILE"
# Stable event for the desktop; normal human output remains on stderr.
printf '[phpup:ready] %s\n' "$SERVER_URL"
[ "$OPEN_BROWSER" -ne 1 ] || open_browser "$SERVER_URL" || true
# Stream server diagnostics without leaving a tail process behind.
TAIL_PID=""
if [ "$VERBOSE" -eq 1 ]; then
  # Keep the live view bounded and follow file replacement during log rotation.
  # Custom PHP error_log destinations remain under the project's control.
  log_files=("$SERVER_LOG")
  if [ -f "$PHPUP_DIR/php.ini" ]; then
    if touch "$PHPUP_DIR/php_errors.log" 2>/dev/null; then log_files+=("$PHPUP_DIR/php_errors.log"); fi
  fi
  tail -q -n 80 -F "${log_files[@]}" & TAIL_PID=$!
fi
exit_status=0
wait "$FRANKENPHP_PID" || exit_status=$?
[ -z "$TAIL_PID" ] || kill "$TAIL_PID" 2>/dev/null || true
if [ "$exit_status" -ne 0 ]; then tail -40 "$SERVER_LOG" >&2; fi
FRANKENPHP_PID=""
exit "$exit_status"
