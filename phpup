  if [ "$SCRIPT_PATH" = "/usr/local/bin/phpup" ]; then
    log "⚠️  phpup is already installed at /usr/local/bin/phpup"
    log "   Running from the same location - no update needed"
  elif [ -f "/usr/local/bin/phpup" ]; then
    log "⚠️  phpup is already installed at /usr/local/bin/phpup"
    printf "   Override existing installation? [y/N]: "
    read -r response
    case "$response" in
      [yY]|[yY][eE][sS])
        log "🔄 Overriding existing installation..."
        cp "$SCRIPT_PATH" /usr/local/bin/phpup || {
          err "Failed to copy phpup to /usr/local/bin/"
          exit 1
        }
        log "✅ Successfully updated phpup at /usr/local/bin/"
        ;;
      *)
        log "❌ Installation cancelled"
        exit 0
        ;;
    esac
  else
    # Copy the script (first time installation)
    cp "$SCRIPT_PATH" /usr/local/bin/phpup || {
      err "Failed to copy phpup to /usr/local/bin/"
      exit 1
    }
    log "✅ Successfully installed phpup to /usr/local/bin/"
  fi

  # Make it executable
  chmod +x /usr/local/bin/phpup || {
    err "Failed to make phpup executable"
    exit 1
  }


  # Check if FrankenPHP is available
  if ! command_exists frankenphp; then
    log "🚀 FrankenPHP not found, attempting to install..."

    # Download and install FrankenPHP
    if command_exists curl; then
      log "   Downloading FrankenPHP installer..."

      # Create temp file for installer (safer than piping to sh)
      INSTALLER_DIR=$(mktemp -d -t phpup-frankenphp-installer.XXXXXX) || {
        err "Failed to create temp directory for installer"
        exit 1
      }
      INSTALLER_TMP="$INSTALLER_DIR/install.sh"
      trap 'rm -rf "$INSTALLER_DIR"' EXIT

      # Download installer script first
      if curl -fsSL https://frankenphp.dev/install.sh -o "$INSTALLER_TMP"; then
        chmod +x "$INSTALLER_TMP"
        log "   Running FrankenPHP installer..."

        if (cd "$INSTALLER_DIR" && BIN_DIR="$INSTALLER_DIR" sh "$INSTALLER_TMP"); then
          rm -f "$INSTALLER_TMP"

          if [ -f "$INSTALLER_DIR/frankenphp" ]; then
            log "   Moving frankenphp to /usr/local/bin/..."
            mv "$INSTALLER_DIR/frankenphp" /usr/local/bin/ && chmod +x /usr/local/bin/frankenphp

            # Verify the binary works
            if /usr/local/bin/frankenphp version >/dev/null 2>&1; then
              log "✅ FrankenPHP installed and verified successfully"
            else
              log "⚠️  FrankenPHP installed but verification failed"
              log "   The binary may be corrupted. Try reinstalling manually: https://frankenphp.dev/docs/install/"
            fi
          elif ! command_exists frankenphp; then
            log "⚠️  FrankenPHP download succeeded but binary not found in current directory"
            log "   You may need to install FrankenPHP manually: https://frankenphp.dev/docs/install/"
          fi
        else
          rm -f "$INSTALLER_TMP"
          log "⚠️  Failed to run FrankenPHP installer"
          log "   Please install FrankenPHP manually: https://frankenphp.dev/docs/install/"
        fi
      else
        rm -f "$INSTALLER_TMP"
        log "⚠️  Failed to download FrankenPHP installer"
        log "   Please install FrankenPHP manually: https://frankenphp.dev/docs/install/"
      fi
    else
      log "⚠️  curl not found - cannot auto-install FrankenPHP"
      log "   Please install FrankenPHP manually: https://frankenphp.dev/docs/install/"
    fi
  else
    log "✅ FrankenPHP is already available"
  fi

  if ! command_exists frankenphp || ! frankenphp version >/dev/null 2>&1; then
    err "phpup was installed, but FrankenPHP is not ready. Install or repair FrankenPHP before starting a server."
    exit 1
  fi

  log "   You can now run 'phpup' from anywhere"
  exit 0
fi

