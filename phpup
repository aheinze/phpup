managed_instances() {
  local dir file pid token path port url child child_token current first=1 failed=0 i attempt
  local -a stopped_pids=() stopped_tokens=()
  dir=$(registry_dir)
  if [ "$STOP_MODE" -eq 0 ]; then
    if [ "$JSON_MODE" -eq 1 ]; then printf '['; else printf 'PID     PORT    STARTED FROM\n'; fi
  fi
  if [ -d "$dir" ] && [ ! -L "$dir" ] && [ "$(get_file_owner_uid "$dir")" = "$(id -u)" ]; then
    for file in "$dir"/*.state; do
      [ -f "$file" ] && [ ! -L "$file" ] || continue
      { IFS= read -r pid; IFS= read -r token; IFS= read -r path; IFS= read -r port; IFS= read -r url; IFS= read -r child; IFS= read -r child_token; } < "$file" || continue
      [[ "$pid" =~ ^[0-9]+$ && "$child" =~ ^[0-9]+$ ]] || continue
      is_own_process "$pid" && is_own_process "$child" || continue
      current=$(process_token "$pid") || continue
      [ -n "$current" ] && [ "$current" = "$token" ] && [ "$(process_token "$child")" = "$child_token" ] || continue
      if [ "$STOP_MODE" -eq 1 ]; then
        if [ "$STOP_ALL" -eq 1 ] || [ "$path" = "$(pwd -P)" ]; then
          if kill -TERM "$pid" 2>/dev/null; then
            stopped_pids+=("$pid"); stopped_tokens+=("$token")
          elif [ "$(process_token "$pid")" = "$token" ]; then
            err "Could not stop managed server $pid"; failed=1
          fi
        fi
      elif [ "$JSON_MODE" -eq 1 ]; then
        [ "$first" -eq 1 ] || printf ','; first=0
        printf '{"pid":'; json_string "$pid"
        printf ',"path":'; json_string "$path"
        printf ',"port":'; json_string "$port"
        printf ',"url":'; json_string "$url"
        printf '}'
      else
        printf '%-7s %-7s %s\n' "$pid" "$port" "$path"
      fi
    done
  fi
  if [ "$STOP_MODE" -eq 1 ]; then
    for i in "${!stopped_pids[@]}"; do
      pid="${stopped_pids[$i]}"; token="${stopped_tokens[$i]}"
      for attempt in $(seq 1 70); do
        [ "$(process_token "$pid")" = "$token" ] || break
        sleep 0.1
      done
      if [ "$(process_token "$pid")" = "$token" ]; then err "Managed server $pid has not stopped yet"; failed=1; fi
    done
  elif [ "$JSON_MODE" -eq 1 ]; then printf ']\n'; fi
  return "$failed"
}

