    log "Please install Git first"
    exit 1
  fi

  log "🐘 Available PHP versions:"
  log "   • 8.4 (latest)  - PHP 8.4.x"
  log "   • 8.3          - PHP 8.3.x (stable)"
  log "   • 8.2          - PHP 8.2.x"
  log "   • 8.1          - PHP 8.1.x"
  log ""

  # PHP version selection
  echo -n "Enter PHP version (8.1, 8.2, 8.3, 8.4) [default: 8.4]: "
